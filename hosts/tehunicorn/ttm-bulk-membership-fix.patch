 	spin_lock(&bo->bdev->lru_lock);
diff -ruN '--color=never' b/include/drm/ttm/ttm_resource.h c/include/drm/ttm/ttm_resource.h
--- b/include/drm/ttm/ttm_resource.h	2026-07-23 22:32:56.642313465 -0400
+++ c/include/drm/ttm/ttm_resource.h	2026-07-23 22:33:36.874072252 -0400
@@ -274,6 +274,15 @@
 	 * @lru: Least recently used list, see &ttm_resource_manager.lru
 	 */
 	struct ttm_lru_item lru;
+
+	/**
+	 * @bulk_tracked: Resource is currently linked inside a
+	 * &ttm_lru_bulk_move range. Tracked explicitly so removal never
+	 * depends on recomputing the BO's evictability, which can change
+	 * (pin, swapout) while the resource is still in the range.
+	 * Protected by ttm_device::lru_lock.
+	 */
+	bool bulk_tracked;
 };
 
