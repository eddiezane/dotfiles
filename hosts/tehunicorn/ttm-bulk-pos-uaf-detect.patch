+/**
+ * ttm_lru_bulk_move_verify_pos - debug check for a stale bulk-move endpoint
+ * @bulk: the bulk move the BO is (or was) tracked in
+ * @res: the resource about to be freed or orphaned
+ * @when: call-site tag for the warning message
+ *
+ * The pos[type][prio].first/.last cache is only repaired by
+ * ttm_lru_bulk_move_del(), which is skipped when the BO currently looks
+ * unevictable. If a resource is freed while it is still a cached range
+ * endpoint, the next bulk operation dereferences freed memory. Catch that
+ * here with a stack trace and repair the cache so the machine survives.
+ */
+void ttm_lru_bulk_move_verify_pos(struct ttm_lru_bulk_move *bulk,
+				  struct ttm_resource *res, const char *when)
+{
+	struct ttm_lru_bulk_move_pos *pos = ttm_lru_bulk_move_pos(bulk, res);
+
+	if (WARN(pos->first == res || pos->last == res,
+		 "TTM: %s: res %p (mem_type %u prio %u pin %u) is a stale bulk pos endpoint\n",
+		 when, res, res->mem_type, res->bo->priority,
+		 res->bo->pin_count))
+		ttm_lru_bulk_move_del(bulk, res);
+}
